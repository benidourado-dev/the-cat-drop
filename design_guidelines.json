  "UNIVERSAL GUIDELINES FOR MAIN AGENT": {
    "testing_attributes": "All interactive elements MUST include kebab-case data-testid attributes (e.g. data-testid=\"shopee-affiliate-button-1\")",
    "header": "Never use fully transparent header without backdrop blur. Use backdrop-blur-xl bg-black/75 z-50",
    "components": "Use standard React .js or .jsx components (not .tsx)."

{
  "project_name": "Shopee Affiliate Product Catalog",
  "app_type": "affiliate product catalog",
  "design_archetype": "PERFORMANCE PRO & SWISS HIGH-CONTRAST",
  "theme": "Dark Mode (Obsidian / Matte Black with Vibrant Amber/Orange Shopee Accents)",
  "typography": {
    "heading_font": "Outfit / Barlow Condensed",
    "body_font": "Inter / DM Sans",
    "mono_font": "JetBrains Mono",
    "font_pairing_strategy": "Bold Athletic / Modern E-Commerce Display",
    "hierarchy": {
      "h1": "text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight",
      "h2": "text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight",
      "h3": "text-xl sm:text-2xl font-semibold",
      "card_title": "text-base sm:text-lg font-bold line-clamp-2",
      "body": "text-sm sm:text-base text-neutral-300",
      "price": "text-lg sm:text-xl font-black text-amber-400",
      "badge": "text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-full"
    }
  },
  "colors": {
    "background_primary": "#0A0A0C",
    "background_secondary": "#121216",
    "surface_card": "#1A1A22",
    "surface_hover": "#242430",
    "border_subtle": "rgba(255, 255, 255, 0.08)",
    "border_active": "rgba(245, 158, 11, 0.4)",
    "brand_shopee_orange": "#EE4D2D",
    "accent_amber": "#F59E0B",
    "text_primary": "#F9FAFB",
    "text_muted": "#9CA3AF",
    "discount_badge_bg": "#EE4D2D",
    "discount_badge_text": "#FFFFFF",
    "forbidden_colors": ["#7351B7", "#1B93A4"]
  },
  "layout_and_spacing": {
    "bento_grid": "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 p-4 md:p-8",
    "card_aspect_ratio": "aspect-square object-cover rounded-t-xl",
    "container_padding": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8",
    "border_padding_rule": "Containers with borders must maintain inner padding (p-4 to p-6) to avoid visual collision"
  },
  "component_guidelines": {
    "product_card": {
      "aspect_ratio": "square (1:1 ratio for product image)",
      "badges": "Discount badge (-XX%) overlaid top-left on image with z-10",
      "affiliate_cta": "'Ver na Shopee' button with Shopee signature orange/amber accent and icon",
      "hover_effect": "Lift on hover (-translate-y-1.5), subtle orange glow border, high contrast image zoom",
      "data_testid_convention": "product-card-{id}, affiliate-button-{id}, discount-badge-{id}"
    },
    "category_filter": {
      "style": "Pill-shaped tab buttons with active amber glow background",
      "data_testid": "category-filter-{category}"
    },
    "header": {
      "style": "Sticky glassmorphism header backdrop-blur-xl bg-black/75 border-b border-white/10 z-50",
      "elements": "Brand logo, search bar with immediate filter, category shortcuts, theme toggle"
    }
  },
